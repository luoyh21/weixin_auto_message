WECOM_CORP_ID=your_corp_id
WECOM_AGENT_ID=1000002
WECOM_SECRET=your_app_secret
WECOM_TO_USER=@all          # @all=该应用可见范围内所有成员；或 UserId1|UserId2

WECOM_CALLBACK_TOKEN=random_token_32_chars
WECOM_CALLBACK_AES_KEY=random_43_chars_base64_chars

OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# 默认走「不调用 LLM」的本地路线：
#   - 翻译：deep-translator -> MyMemory（mainland 可达，无需 key）
#   - 总览：textrank4zh 抽取式（jieba + TextRank）
# 把以下任一开关置为 1 时会切回 LLM 路径，要求 OPENAI_* 可用。
TRANSLATE_USE_LLM=0
SUMMARIZER_USE_LLM=0
# 若部署在能直连 translate.googleapis.com 的环境（境外 VPS / 有 proxy），
# 可置 1 让翻译优先调 Google，失败再退回 MyMemory。
TRANSLATE_USE_GOOGLE=0

SERVER_HOST=0.0.0.0
SERVER_PORT=8080

SPACENEWS_RSS=https://spacenews.com/feed/
OPML_PATH=data/zlzchat.opml

DAILY_MORNING_HOUR=8
DAILY_MORNING_MINUTE=0
DAILY_EVENING_HOUR=17
DAILY_EVENING_MINUTE=0
DAILY_TZ=Asia/Shanghai
DAILY_WINDOW_HOURS=12
